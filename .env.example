# Copy this to .env and fill in your values
#
# Option A: OmniRoute (Free / OpenAI-compatible proxy)
# OPENAI_API_KEY=your_omniroute_key_here
# OPENAI_BASE_URL=https://your-omniroute-endpoint/v1
# OPENAI_MODEL=gpt-4o-mini

# Option B: Google Gemini (Free tier via Google AI Studio)
# OPENAI_API_KEY=AIzaSy...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-1.5-flash

# Option C: Groq (Free fast inference)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Option D: Direct OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
